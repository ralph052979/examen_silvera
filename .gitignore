# Licencia de VASP: el POTCAR no se publica (su identidad queda en entradas/POTCAR.titel y .sha256)
POTCAR
# Librerias copiadas del login (ver README, seccion Granado)
lib/
# Corridas: de cada corrida solo se publican los archivos pequenos (entradas, tiempos, afinidad,
# hilos, OSZICAR y OUTCAR), para que el analisis se pueda repetir desde un clon. El POTCAR y los
# archivos grandes de VASP nunca se publican (ver abajo).
corridas/*/*
!corridas/*/tiempo.txt
!corridas/*/entorno.txt
!corridas/*/afinidad.txt
!corridas/*/hilos.txt
!corridas/*/progreso.txt
!corridas/*/geometria_pasos.txt
!corridas/*/carga.txt
!corridas/*/INCAR
!corridas/*/KPOINTS
!corridas/*/OSZICAR
!corridas/*/OUTCAR
# Registros de Slurm: solo las listas de jobs de cada parte (no las salidas .out)
logs/*
!logs/jobs_*.txt
# Archivos grandes de VASP
WAVECAR
CHGCAR
CHG
vasprun.xml
PROCAR
DOSCAR
EIGENVAL
# Temporales
*.swp
__pycache__/
*.pyc
# Subproductos de LaTeX
reporte/*.aux
reporte/*.log
reporte/*.out
reporte/*.toc
